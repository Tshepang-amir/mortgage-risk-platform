# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- FRED macro series (section 3). Free API key from fred.stlouisfed.org ---
FRED_API_KEY=

# --- Local data roots (section 9). Absolute paths inside WSL2 for Spark work ---
DATA_RAW_DIR=./data/raw
DATA_EXTERNAL_DIR=./data/external
DELTA_ROOT=./data/delta

# --- MLflow (section 8) ---
# Port 5000 is commonly taken on Windows dev machines; compose publishes
# MLflow on MLFLOW_PORT (default 5555).
MLFLOW_PORT=5555
MLFLOW_TRACKING_URI=http://127.0.0.1:5555
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# --- Postgres backing MLflow ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=
POSTGRES_DB=mlflow
POSTGRES_PORT=5432

# --- Spark (section 10, memory-bound on a laptop) ---
SPARK_DRIVER_MEMORY=4g
SPARK_LOCAL_DIRS=/tmp/spark
